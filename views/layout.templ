package views

templ Layout() {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tandil App</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="styles.css"/>
		</head>
		<body>
			<header class="cabecera">
				<a class="marca" href="#inicio">Tandil <span>App</span></a>
				<nav class="navegacion" aria-label="Navegación principal">
					<a href="#eventos">Events</a>
					<a href="#categorias">Categories</a>
					<a href="#contacto">Contact</a>
					<label class="buscador">
						<span class="sr-only">Buscar eventos</span>
						<input type="search" id="buscador" placeholder="Buscar eventos…"/>
					</label>
					<button class="boton" type="button" data-abrir-dialogo="dialogo-registro">Sign Up</button>
				</nav>
			</header>
			<p id="mensaje" role="status"></p>
			<main>
				<section class="hero contenedor" id="inicio">
					<div class="hero-texto">
						<p class="antetitulo">Agenda cultural de la ciudad</p>
						<h1>Descubrí qué hacer en <em>Tandil</em></h1>
						<p>Talleres, música, ferias y paseos para disfrutar la ciudad. Encontrá tu próxima salida en un solo lugar.</p>
						<a class="boton" href="#eventos">Explorar eventos</a>
					</div>
					<div class="hero-imagenes" aria-hidden="true">
						<figure class="visual visual-grande">
							<svg viewBox="0 0 260 340" preserveAspectRatio="xMidYMid slice">
								<rect width="260" height="340" fill="#F7D89A"></rect>
								<circle cx="190" cy="76" r="38" fill="#DF6D41"></circle>
								<path d="M0 250 L70 140 L125 220 L175 130 L260 250 V340 H0 Z" fill="#8DA6CC"></path>
								<path d="M0 290 L85 205 L150 275 L205 220 L260 265 V340 H0 Z" fill="#AAA648"></path>
								<rect y="318" width="260" height="22" fill="#F7BCBD"></rect>
							</svg>
						</figure>
						<figure class="visual">
							<svg viewBox="0 0 180 150" preserveAspectRatio="xMidYMid slice">
								<rect width="180" height="150" fill="#F7BCBD"></rect>
								<circle cx="90" cy="75" r="50" fill="#FFFFFF" opacity=".35"></circle>
								<circle cx="66" cy="100" r="12" fill="#2F2A26"></circle>
								<circle cx="120" cy="88" r="12" fill="#2F2A26"></circle>
								<rect x="76" y="45" width="6" height="55" fill="#2F2A26"></rect>
								<rect x="130" y="33" width="6" height="55" fill="#2F2A26"></rect>
								<path d="M76 45 L136 33 L136 45 L76 57 Z" fill="#2F2A26"></path>
							</svg>
						</figure>
						<figure class="visual">
							<svg viewBox="0 0 180 150" preserveAspectRatio="xMidYMid slice">
								<rect width="180" height="150" fill="#8DA6CC"></rect>
								<rect x="35" y="30" width="110" height="92" rx="12" fill="#FFFFFF"></rect>
								<rect x="35" y="30" width="110" height="26" rx="12" fill="#DF6D41"></rect>
								<rect x="55" y="72" width="20" height="20" rx="4" fill="#F7D89A"></rect>
								<rect x="85" y="72" width="20" height="20" rx="4" fill="#F7BCBD"></rect>
								<rect x="115" y="72" width="20" height="20" rx="4" fill="#AAA648"></rect>
								<rect x="55" y="98" width="20" height="12" rx="4" fill="#8DA6CC"></rect>
								<rect x="85" y="98" width="20" height="12" rx="4" fill="#F7D89A"></rect>
							</svg>
						</figure>
					</div>
				</section>
				{ children... }
			</main>
			<footer class="pie" id="contacto">
				<div class="contenedor">
					<div class="pie-contenido">
						<div>
							<h2>Tandil App</h2>
							<p>La agenda cultural de Tandil. Eventos, talleres y propuestas para toda la familia.</p>
						</div>
						<div>
							<h3>Contact</h3>
							<p><a href="mailto:hola@tandilapp.com">hola@tandilapp.com</a></p>
							<p><a href="tel:+542494000000">+54 249 400-0000</a></p>
							<p>San Martín 123, Tandil</p>
						</div>
						<div>
							<h3>Seguinos</h3>
							<div class="redes">
								<a href="#" aria-label="Instagram">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"></rect>
										<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
										<circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"></circle>
									</svg>
								</a>
								<a href="#" aria-label="Facebook">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1Z"></path>
									</svg>
								</a>
								<a href="#" aria-label="WhatsApp">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.4A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.7-.2-.3A8 8 0 1 1 12 20Zm4.5-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.7.5 0 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.2-.2-.4-.3Z"></path>
									</svg>
								</a>
							</div>
						</div>
					</div>
					<p class="copyright">© 2026 Tandil App. Todos los derechos reservados.</p>
				</div>
			</footer>
			@SignUpDialog()
			@EventDialog()
			@CategoryDialog()
			<script src="app.js"></script>
		</body>
	</html>
}
