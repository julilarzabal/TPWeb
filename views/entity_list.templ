package views

templ EventList() {
	<section class="seccion contenedor" id="eventos">
		<div class="seccion-cabecera">
			<div>
				<p class="antetitulo">Agenda de la ciudad</p>
				<h2>Events</h2>
			</div>
			<button class="boton" type="button" data-abrir-dialogo="dialogo-evento">Create Event</button>
		</div>
		<div class="carrusel">
			<button class="carrusel-flecha" id="carrusel-prev" type="button" aria-label="Eventos anteriores">‹</button>
			<div id="lista-eventos" class="carrusel-pista"></div>
			<button class="carrusel-flecha" id="carrusel-next" type="button" aria-label="Eventos siguientes">›</button>
		</div>
	</section>
}

templ CategoryList() {
	<section class="seccion contenedor" id="categorias">
		<div class="seccion-cabecera">
			<div>
				<p class="antetitulo">Explorá por tema</p>
				<h2>Categories</h2>
			</div>
			<button class="boton boton-azul" type="button" data-abrir-dialogo="dialogo-categoria">Create Category</button>
		</div>
		<ul id="lista-categorias" class="lista-categorias"></ul>
	</section>
}

templ UserList() {
	<h3 class="subtitulo">Usuarios registrados</h3>
	<ul id="lista-usuarios" class="lista-simple"></ul>
}
