package views

import (
	"fmt"

	sqlc "TPEspecial.com/ProgramacionWeb/TPEspecial/db/sqlc"
)

templ EventList(events []sqlc.Event, users []sqlc.User) {
	<section class="seccion contenedor" id="eventos">
		<div class="seccion-cabecera">
			<div>
				<p class="antetitulo">Agenda de la ciudad</p>
				<h2>Events</h2>
			</div>
			@EventPanel(users)
		</div>
		@EventItems(events)
	</section>
}

templ CategoryList(categories []sqlc.Category) {
	<section class="seccion contenedor" id="categorias">
		<div class="seccion-cabecera">
			<div>
				<p class="antetitulo">Explorá por tema</p>
				<h2>Categories</h2>
			</div>
			@CategoryPanel()
		</div>
		@CategoryItems(categories)
	</section>
}

// EventItems es el fragmento que HTMX reemplaza al crear un evento.
// Siempre renderiza el contenedor #event-list (aunque no haya eventos)
// para que hx-target lo encuentre.
templ EventItems(events []sqlc.Event) {
	<div id="event-list">
		if len(events) == 0 {
			<p class="vacio">Todavía no hay eventos. Publicá el primero con el botón Create Event.</p>
		} else {
			<div class="lista-eventos">
				for _, event := range events {
					<article class="evento">
						<h3>{ event.Title }</h3>
						<p class="fecha">{ event.Fecha.Format("02/01/2006") }</p>
						<p class="rango">Rango de edad: { event.AgeRange }</p>
						if event.Description != nil {
							<p>{ *event.Description }</p>
						}
						<p class="lugar">{ event.Location }</p>
						<div class="acciones-evento">
							<button
								type="button"
								class="boton-modificar"
								hx-get={ fmt.Sprintf("/events/%d/edit", event.ID) }
								hx-target="closest article"
								hx-swap="outerHTML"
							>Modify</button>
							<button
								type="button"
								class="boton-eliminar"
								hx-delete={ fmt.Sprintf("/events/%d", event.ID) }
								hx-target="closest article"
								hx-swap="outerHTML"
								hx-confirm="¿Eliminar este evento?"
							>Delete</button>
						</div>
					</article>
				}
			</div>
		}
	</div>
}

// CategoryItems es el fragmento que HTMX reemplaza al crear una categoría.
templ CategoryItems(categories []sqlc.Category) {
	<div id="category-list">
		if len(categories) == 0 {
			<p class="vacio">Todavía no hay categorías. Creá la primera con el botón Create Category.</p>
		} else {
			<ul class="lista-categorias">
				for _, category := range categories {
					<li>
						<span>{ category.Name }</span>
						<button
							type="button"
							class="boton-eliminar"
							hx-delete={ fmt.Sprintf("/categories/%d", category.ID) }
							hx-target="closest li"
							hx-swap="outerHTML"
							hx-confirm="¿Eliminar esta categoría?"
						>Delete</button>
					</li>
				}
			</ul>
		}
	</div>
}